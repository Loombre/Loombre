# pnpm v11's verify-deps-before-run pre-script check is disabled
# repo-wide: on this multi-process checkout it intermittently decides the
# workspace needs a `pnpm install --production` reconcile before running
# ANY script, then aborts in non-TTY shells
# (ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY) — and once, with CI=true
# set, actually pruned ~600 packages of hoisted devDeps from the shared
# node_modules mid-wave (the incident installers/macos/build-pkg.mjs's
# run() header documents). Dependency freshness is already enforced where
# it matters: CI always runs `pnpm install --frozen-lockfile` first.
verify-deps-before-run=false
