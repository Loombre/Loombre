<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Loombre :: installers/windows/service-host/LoombreServiceHost

    Generic Windows Service wrapper around a plain child process (node.exe
    running one of Loombre's dist entrypoints) — see
    installers/windows/msi/Services.wxs's header for the full evidence
    trail on WHY this exists (a bare node.exe cannot register with SCM or
    receive a clean stop signal on its own).

    net8.0-windows: Windows-only surface (ServiceBase, the console-signal
    P/Invokes). CORRECTION (first-ever Windows compile, diag run
    30218015372): System.ServiceProcess.ServiceBase does NOT ship in the
    "-windows" reference assemblies as this comment previously claimed —
    it lives only in the System.ServiceProcess.ServiceController NuGet
    package (MIT, © .NET Foundation; recorded in LICENSE-INTENT.md),
    referenced below. EnableWindowsTargeting exists so the macOS dev host
    can run compile-only proofs (dotnet build/publish) — without it, any
    "-windows" TFM fails restore off-Windows with NETSDK1100.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Loombre.ServiceHost</RootNamespace>
    <AssemblyName>LoombreServiceHost</AssemblyName>

    <!-- Self-contained single-file win-x64 publish (mission deliverable 1:
         "buildable on macOS with the windows runtime pack for compile/
         publish" — build-msi.mjs's `dotnet publish` step relies on these
         being the project defaults so it never has to remember extra
         flags). P4.1: unsigned — build-msi.mjs's sign step (no-op today,
         installers/sign-hook.mjs) is the insertion point for a future
         Authenticode signature over this exe. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoombreServiceHost.Core\LoombreServiceHost.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

</Project>
