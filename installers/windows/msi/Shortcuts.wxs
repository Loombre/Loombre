<?xml version="1.0" encoding="utf-8"?>
<!--
  Loombre :: installers/windows/msi/Shortcuts.wxs

  Start Menu shortcut for the tray controller + a per-machine autostart
  registration (HKLM Run key — per-machine because this whole install is
  per-machine, ALLUSERS=1 via Package/@Scope in Package.wxs; a per-user Run
  key would need a per-user install context this product doesn't use). The
  tray is what a user is meant to actually SEE after install; the three
  Windows services (server, worker, web) start themselves independently at
  boot regardless of whether any user ever logs in or the tray ever runs
  (Start="auto" in Services.wxs — true again since the installer
  completeness audit made the bundled node runtime real) — the tray is a
  status/control surface over them, not their supervisor.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="ShortcutComponents">
      <Component Id="cmp.StartMenuShortcut" Directory="APPLICATIONPROGRAMSFOLDER" Guid="*">
        <!-- Icon references the Icon/@Id authored in Package.wxs (WiX links
             Icon rows across fragments in the same package). Belt-and-
             braces alongside the tray exe's own embedded ApplicationIcon:
             an explicit shortcut icon is what the Start Menu actually
             caches, and it keeps the tile correct even if the exe is ever
             rebuilt without its resource. -->
        <Shortcut
          Id="shortcut.LoombreTray"
          Name="Loombre"
          Description="Loombre tray controller — status, start/stop, open web client."
          Target="[TRAYDIR]Loombre.Tray.exe"
          WorkingDirectory="TRAYDIR"
          Icon="loombre.ico" />
        <!-- A Component that only contains a Shortcut still needs its own
             KeyPath and needs the Start Menu folder cleaned up on
             uninstall when it's the last thing in it. -->
        <RemoveFolder Id="rmf.ApplicationProgramsFolder" Directory="APPLICATIONPROGRAMSFOLDER" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\Loombre"
          Name="StartMenuShortcutInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>

      <Component Id="cmp.TrayAutostart" Directory="TRAYDIR" Guid="*">
        <!-- HKLM Run key (all-users autostart) rather than HKCU: this is a
             per-machine install (Package/@Scope="perMachine" in
             Package.wxs) with no per-user install context, and the tray is
             a lightweight status client any interactively-logged-in user
             on the machine should see, not a per-account preference.

             The literal flag here is pinned by
             Loombre.Tray.Tests/TrayLaunchModeTests.cs: logon autostart
             must stay a silent icon (no browser popping up at every
             login), which is exactly what distinguishes it from the
             flagless Start Menu shortcut above — the "nothing happens"
             rc field-report fix gave the three launch paths three
             intents (TrayLaunchModes.cs). -->
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
          Name="LoombreTray"
          Type="string"
          Value="&quot;[TRAYDIR]Loombre.Tray.exe&quot; --autostart"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
