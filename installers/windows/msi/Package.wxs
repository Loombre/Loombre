<?xml version="1.0" encoding="utf-8"?>
<!--
  Loombre :: installers/windows/msi/Package.wxs

  Top-level WiX v4 authoring for the Windows MSI (STATE.md P4.1/P4.9,
  docs/PLAN.md §11). Linked together with Directories.wxs, Files.wxs,
  Services.wxs, Firewall.wxs, Shortcuts.wxs by build-msi.mjs's `wix build`
  invocation — see that script's header for the exact command line
  (preprocessor -d values, -ext extension references).

  Per-machine, upgrade-safe: Package/@Scope="perMachine" + a STABLE
  UpgradeCode (never changes across releases, see below) + <MajorUpgrade>
  is the whole of WiX's "install v2 cleanly replaces v1" contract — no
  custom upgrade logic needed. ProductVersion is re-derived every build
  from root package.json (P4.11 single-source-of-version) via
  -d ProductVersion=… ; the MSI's own ProductCode is left to WiX's default
  per-build auto-generation (omit Package/@Id — WiX v4 defaults to "*",
  meaning "new GUID every build"), which is exactly what a MajorUpgrade
  needs: ProductCode MUST differ build-to-build for the standard major-
  upgrade pattern to detect "a different, newer product" at all.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- ========================================================================
       UpgradeCode: 5F8B7B26-A5C5-4AA4-B2F1-09DB733A5719

       Generated ONCE for this MSI (uuidgen, this lane, this build) and
       committed here as a literal constant. THIS VALUE MUST NEVER CHANGE —
       it is the sole identity MajorUpgrade uses to recognize "an earlier
       Loombre install" across every future version. Recorded again in the
       I3 report for visibility outside this file.
       ==================================================================== -->
  <?define UpgradeCode = "5F8B7B26-A5C5-4AA4-B2F1-09DB733A5719" ?>

  <!-- The server listen port lives in ServerPort.wxi (WiX defines are
       per-source-file, so the files that USE it — Services.wxs,
       Firewall.wxs — each include it there; this file does not use it). -->

  <!-- Version is $(var.MsiVersion), NOT the full release version:
       Windows Installer requires a plain numeric major.minor.build
       ProductVersion (WIX1148 fired on '0.9.0-rc.1' — labels make
       version comparison, and therefore MajorUpgrade, undefined).
       build-msi.mjs derives MsiVersion by stripping any prerelease
       label; the full semver still names the .msi file itself. On a
       final x.y.z release the two are identical. -->
  <Package
    Name="Loombre"
    Manufacturer="Loombre"
    Version="$(var.MsiVersion)"
    UpgradeCode="$(var.UpgradeCode)"
    Language="1033"
    Scope="perMachine"
    InstallerVersion="500">

    <SummaryInformation Keywords="Loombre" Description="Loombre media server installer" Manufacturer="Loombre" />

    <!-- P4.1: UNSIGNED dev-mode posture — no Authenticode certificate
         exists for this build (no revenue, no telemetry; trust is
         delivered via checksum + minisign per P4.9/docs/install/windows.md).
         This MSI is therefore expected to trigger SmartScreen on first run
         of the downloaded file AND on first service/tray launch — that is
         the documented, honest v1 experience, not a bug to silently work
         around. build-msi.mjs's sign step calls installers/sign-hook.mjs
         (lane I1, no-op today) AFTER `wix build` produces this .msi, so
         adding a real certificate later is a pipeline change, not a
         rework of this authoring. -->

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first if you need to downgrade."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Brand icon. Without these two lines Add/Remove Programs (Settings >
         Installed apps) renders Loombre with the generic blank-package
         glyph, and the Start Menu shortcut inherits whatever the tray exe
         carries. The .ico is a committed, regenerable container built from
         design/blaze's 1024px source by scripts/build-app-icons.mjs; it
         holds 16/24/32/48/64/128/256 px so the shell never has to upscale
         a small bitmap for a high-DPI Start Menu tile.
         ARPPRODUCTICON takes the Icon/@Id — MSI resolves it through the
         Icon table, NOT a file path. -->
    <Icon Id="loombre.ico" SourceFile="$(var.BrandIcon)" />
    <Property Id="ARPPRODUCTICON" Value="loombre.ico" />

    <!-- ==================================================================
         Visual C++ runtime prerequisite (v0.9.0-rc.1 field failure)
         ==================================================================
         A clean Windows 11 machine installed this MSI with "Installation
         success or error status: 0" and then could not run Loombre at all:
         LoombreServer and LoombreWorker died at boot, three restarts each,
         on ERR_DLOPEN_FAILED loading @napi-rs/keyring's .node — and had
         they survived that, embedded PostgreSQL would have failed next.
         Both binaries import VCRUNTIME140.dll:

           keyring.win32-x64-msvc.node -> KERNEL32, VCRUNTIME140.dll,
               advapi32, bcryptprimitives, api-ms-win-crt-*
           pg\...\bin\postgres.exe     -> KERNEL32, VCRUNTIME140.dll,
               Secur32, WS2_32, libcrypto-3-x64, icu*, api-ms-win-crt-*

         The api-ms-win-crt-* (UCRT) half IS part of Windows 10+.
         VCRUNTIME140.dll is NOT — it comes from the Visual C++ 2015-2022
         redistributable. Every GitHub Actions windows runner has it
         (Visual Studio is preinstalled), which is precisely why the
         release's own install smoke could assert /healthz 200 against an
         MSI that was dead on arrival everywhere else. Node itself is fine
         (official Windows builds link the CRT statically), which is why
         the web service kept serving :3000 while nothing else worked —
         the single most confusing part of the field report.

         A blocking LaunchCondition, not a warning: the redistributable is
         required for the DEFAULT database. Without it there is no working
         install to degrade into, and the failure mode it replaces is a
         silent one that cost a full debugging session to diagnose.

         SystemFolder is the NATIVE (64-bit) System32 here because this
         package is x64 (Package/@InstallerVersion + ProgramFiles64Folder);
         a 32-bit package would be redirected to SysWOW64 and find the
         wrong architecture's copy. FileSearch keys on the file, not on a
         registry version stamp, because the DLL is what actually has to
         load — a present-but-repaired/rolled-back registry entry is not
         evidence, and the loader does not consult it. -->
    <Property Id="LOOMBRE_VCRUNTIME140">
      <DirectorySearch Id="dir.SystemFolderForVcRuntime" Path="[SystemFolder]">
        <FileSearch Id="file.VcRuntime140" Name="vcruntime140.dll" />
      </DirectorySearch>
    </Property>
    <!-- Second, INDEPENDENT signal, OR'd with the file search below. This
         is deliberately fail-OPEN rather than fail-closed. A blocking
         condition that depends on one detection mechanism is only as good
         as that mechanism: if the AppSearch above ever failed to populate
         its property (a locked-down SystemFolder, a future WiX change in
         how DrLocator resolves a property-valued Path), the condition
         would refuse to install on machines that are perfectly fine — a
         strictly worse outcome than the bug it guards against, and one
         that would hit EVERY user rather than the subset with no runtime.
         Requiring both signals to be absent before blocking means a
         detection bug degrades to today's behaviour, not to a brick.
         `SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64` is the
         redistributable's own canonical install marker (the "14.0" is the
         VC toolset lineage — 2015 through 2022 all share it, which is
         exactly the span that provides VCRUNTIME140.dll).
         Bitness="always64" because an x64 package must not be redirected
         into the WOW6432Node view, where the x86 runtime's key lives. -->
    <Property Id="LOOMBRE_VCREDIST_REGISTERED">
      <RegistrySearch
        Id="reg.VcRedistX64"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
        Name="Installed"
        Type="raw"
        Bitness="always64" />
    </Property>
    <Launch
      Condition="Installed OR REMOVE OR LOOMBRE_VCRUNTIME140 OR LOOMBRE_VCREDIST_REGISTERED"
      Message="Loombre requires the Microsoft Visual C++ 2015-2022 Redistributable (x64), which is not installed on this computer. Loombre's bundled PostgreSQL database and its secure-credential support both depend on it, and neither can start without it.

Install it first, then run this installer again:

  winget install --id Microsoft.VCRedist.2015+.x64 -e

or download it from https://aka.ms/vs/17/release/vc_redist.x64.exe" />

    <!-- ProgramData\Loombre\{data,logs} must exist even on a bare
         install before any service has run once (LoombreServiceHost writes
         its log file lazily but the ServiceInstall log-path argument's
         PARENT directory must already exist; embedded-PG provisioning, once lane B lands,
         expects its dataDir to pre-exist too, matching
         packages/provisioning's "caller resolves the path, this package
         never creates directories" convention). Left at DEFAULT ACL
         inheritance from %ProgramData% (SYSTEM/Administrators full
         control, Users read — Windows' own out-of-the-box default for
         that folder) rather than hand-authored PermissionEx entries: the
         services run as LocalSystem (full access regardless) and the tray
         only needs to READ inside this tree — see the I3 report's flagged
         finding about the discovery/token file's 0600-vs-Windows-ACL gap,
         which is a SERVER-side (not installer-side) concern. -->
    <!-- Explicit GUIDs, not Guid="*": WIX0230 (first real `wix build`,
         diag run 30218812062) — a CreateFolder-only component's KeyPath
         is its Directory, which disqualifies auto-generated guids.
         PERMANENT once shipped, same rule as UpgradeCode above: MSI
         component rules key on these identities across every future
         upgrade — never regenerate them. -->
    <ComponentGroup Id="AppDataFolders">
      <Component Id="cmp.AppDataDataFolder" Directory="APPDATA_DATA" Guid="2D43F24B-15DB-4C51-86A7-CAE9419E1AEC">
        <CreateFolder />
      </Component>
      <Component Id="cmp.AppDataLogsFolder" Directory="APPDATA_LOGS" Guid="06F6DD6F-2FCB-4A9F-8B15-231E9CC804A6">
        <CreateFolder />
      </Component>
      <!-- cmp.AppDataPgdataFolder (Guid 654D4DEC-F8D7-4D5B-B7E2-EC4A2FC7BBB9)
           REMOVED here, never shipped in a public release: the real
           embedded-PG cluster lives at ProgramData\Loombre\postgres\data,
           created at runtime by apps/server's provisioning bootstrap —
           see Directories.wxs (installer completeness audit). The GUID is
           recorded so it is never reused for a different component. -->
    </ComponentGroup>

    <!-- The extracted-payload trees (server/worker/web/node/pg — see
         Files.wxs's archived-payload header) plus the extractor's marker
         file are UNREGISTERED files MSI knows nothing about, so plain
         uninstall would orphan hundreds of MB under Program Files.
         util:RemoveFolderEx sweeps the whole install folder at uninstall
         time. The registry value is the canonical RemoveFolderEx pattern
         (and this component's keypath): the path must be REMEMBERED in
         the registry because at uninstall time the Directory table that
         produced [INSTALLFOLDER] is no longer trustworthy. Runs on the
         OLD product during a MajorUpgrade too (its uninstall leg) — that
         is correct and load-bearing: it clears stale extracted trees so
         the new version's first service start re-extracts its own
         payload (PayloadExtractor's marker is swept with them). -->
    <Property Id="INSTALLFOLDER_TO_CLEAN">
      <RegistrySearch
        Id="rs.InstallFolderToClean"
        Root="HKLM"
        Key="SOFTWARE\Loombre"
        Name="InstallDir"
        Type="raw" />
    </Property>
    <ComponentGroup Id="CleanupComponents" Directory="INSTALLFOLDER">
      <Component Id="cmp.PayloadCleanup" Guid="*">
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\Loombre"
          Name="InstallDir"
          Type="string"
          Value="[INSTALLFOLDER]"
          KeyPath="yes" />
        <util:RemoveFolderEx Property="INSTALLFOLDER_TO_CLEAN" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- Install-time payload extraction (added after the v0.9.0-rc.1
         install test: leaving payload.zip packed until first service
         start meant a fresh install had NO server/worker/web trees on
         disk — and today's demand-start services can't run yet, so
         nothing would ever unpack). Deferred + elevated, after
         InstallFiles so payload.zip and LoombreServiceHost.exe are both
         on disk; ExeCommand is Formatted and resolves when the deferred
         script is generated. Return="check": a failed extraction fails
         the install loudly (rollback removes MSI-owned files; any
         partially-extracted trees are swept by the next install's
         stale-tree removal or by uninstall's RemoveFolderEx). The
         services' own extract-zip/extract-to flags stay as a first-start
         SELF-HEAL — after a healthy install the marker matches and it
         costs one hash pass. Same trailing-dot idiom as Services.wxs
         (see its header's TRAILING-BACKSLASH TRAP note). -->
    <CustomAction
      Id="ca.ExtractPayload"
      FileRef="file.LoombreServiceHost"
      ExeCommand='--extract-cli "[PAYLOADDIR]payload.zip" "[INSTALLFOLDER]."'
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <!-- Launch the tray controller when the install finishes (rc.1 field
         report: "nothing happens ... I open the app via the start menu").
         The MSI already registered the tray for autostart (Shortcuts.wxs's
         HKLM Run key) — but a Run key fires at LOGON, so on the install
         itself nothing appeared, and the operator had no on-screen
         evidence that three services had just started. This closes that
         gap on the same install, without waiting for a logout.

         Type-50 (Property + ExeCommand) rather than FileRef: the tray's
         files are harvested wholesale by Files.wxs's `<Files Include>`,
         so their File ids are compiler-generated and NOT stable enough to
         reference by name. SetProperty resolves [TRAYDIR] at run time
         (a literal `<Property>` value would ship the unexpanded token —
         Property-table values are not Formatted).

         Impersonate="yes" + Execute="immediate" runs it as the operator
         who started the install, NOT as the elevated installer identity —
         a tray icon spawned from the SYSTEM/elevated context would land
         in the wrong session (or none) and could not talk to that user's
         desktop. Return="asyncNoWait" so a UI app that stays running
         cannot hang the installer's final progress bar.

         UILevel > 2 skips this for fully-silent (`/qn`) installs — an
         unattended/enterprise deployment must not have a tray icon pop up
         on whoever happens to be logged in; those installs still get the
         Run key for the next logon. -->
    <SetProperty
      Id="LOOMBRETRAYEXE"
      Value="[TRAYDIR]Loombre.Tray.exe"
      After="CostFinalize"
      Sequence="execute"
      Condition="NOT REMOVE" />
    <CustomAction
      Id="ca.LaunchTray"
      Property="LOOMBRETRAYEXE"
      ExeCommand=""
      Execute="immediate"
      Impersonate="yes"
      Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="ca.ExtractPayload" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="ca.LaunchTray" After="InstallFinalize" Condition="NOT REMOVE AND UILevel &gt; 2" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Loombre" Level="1" AllowAbsent="no" AllowAdvertise="no">
      <ComponentGroupRef Id="PayloadFiles" />
      <ComponentGroupRef Id="FfmpegFiles" />
      <ComponentGroupRef Id="TrayFiles" />
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="FirewallComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
      <ComponentGroupRef Id="AppDataFolders" />
      <ComponentGroupRef Id="CleanupComponents" />
    </Feature>

    <!-- WixToolset.Firewall.wixext supplies fw:FirewallException
         (Firewall.wxs); WixToolset.Util.wixext supplies
         util:RemoveFolderEx (cleanup component above) — both pinned in
         lockstep with the wix tool itself (build-msi.mjs). Everything
         else (ServiceInstall/ServiceControl/RegistryValue/Shortcut/
         CreateFolder) is core v4 schema, not extension elements. -->
  </Package>
</Wix>
