<?xml version="1.0" encoding="utf-8"?>
<!--
  Loombre :: installers/windows/msi/Files.wxs

  Payload harvesting.

  ARCHIVED-PAYLOAD MODEL (owner decision after diag run 30219204709): the
  five big trees — server, worker, web, node, pg — are NOT harvested
  file-by-file. The first real `wix build` proved they cannot be: glob
  harvesting produced 84,305 Components against the MSI format's hard
  65,536 ceiling (WIX7502). build-msi.mjs zips those five staged trees
  into ONE payload.zip (top-level names matching Directories.wxs's
  SERVERDIR/WORKERDIR/WEBDIR/NODEDIR/PGDIR), this file installs that zip
  as a single component into PAYLOADDIR, and LoombreServiceHost.exe (in
  extract-cli mode) unpacks it into the install folder AT INSTALL TIME
  (Package.wxs's ca.ExtractPayload, deferred after InstallFiles) with a
  first-service-start self-heal via the same PayloadExtractor.cs (sha256
  marker for idempotence, mutex against racing instances, stale-tree
  removal on upgrade; Package.wxs's cleanup component removes the
  extracted trees at uninstall via util:RemoveFolderEx).

  The small, stable trees (ffmpeg, tray publish output) are still glob-
  harvested below with WiX v4's <Files Include="…\**"/> — per-file
  components with real MSI servicing are strictly better where the count
  is nowhere near the ceiling.

  All $(var.*) preprocessor variables are supplied by build-msi.mjs's
  `wix build -d Name=value` invocation (see that script's header for the
  exact staging paths). Every one of them MUST point at an already-staged
  path before `wix build` runs — this file performs no fetching/building
  itself (CLAUDE.md invariant 6 spirit: no I/O in authoring, orchestration
  lives in the build script).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="PayloadFiles" Directory="PAYLOADDIR">
      <Component Id="cmp.PayloadZip" Guid="*">
        <File Id="file.PayloadZip" Source="$(var.PayloadZip)" Name="payload.zip" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- $(var.FfmpegDir) is build-msi.mjs's fetchFfmpegWindows() result:
         lane I1's SHARED scripts/fetch-ffmpeg.mjs (landed; verified and
         wired to its real CLI, not a guessed one) fetching the pinned
         windows-x64 ffmpeg/ffprobe pair from installers/ffmpeg-manifest.json
         into vendor/ffmpeg/windows-x64. If that script is ever absent
         (e.g. a partial checkout), build-msi.mjs falls back to a
         marker-file placeholder so `wix build` never fails on a missing
         source root — an installer built from that fallback installs
         successfully but cannot transcode, surfaced loudly in the build
         script's console output, not hidden here. -->
    <ComponentGroup Id="FfmpegFiles" Directory="FFMPEGDIR">
      <Files Include="$(var.FfmpegDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- installers/windows/tray's `dotnet publish` output. Self-contained
         + PublishSingleFile means this is normally exactly one .exe (plus,
         depending on trimming settings, a handful of native satellite
         files) — still globbed rather than hand-listed so a publish-output
         shape change (e.g. ReadyToRun composite images) never silently
         drops a required file. -->
    <ComponentGroup Id="TrayFiles" Directory="TRAYDIR">
      <Files Include="$(var.TrayPublishDir)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
