<?xml version="1.0" encoding="utf-8"?>
<!--
  Loombre :: installers/windows/msi/Directories.wxs

  The two directory trees this installer populates, per docs/PLAN.md §11 /
  STATE.md P4.1:

    Program Files\Loombre\...   — the immutable install payload (per-machine,
                                  MajorUpgrade-replaced wholesale on upgrade)
    ProgramData\Loombre\...     — the ProvisioningInterface data-dir (P4.2/
                                  P4.7: embedded-PG data, secrets, logs,
                                  crash files) — created here, but its
                                  CONTENTS are owned at runtime by the
                                  server/worker processes and by lane B's
                                  provisioning boot seam, never by this MSI
                                  beyond creating the empty directories and
                                  setting ACLs (Registry.wxs/Services.wxs).

  WiX v4 StandardDirectory replaces v3's hand-nested
  TARGETDIR -> ProgramFilesFolder boilerplate — see WiX v4 migration notes.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- ProgramFiles64Folder, NOT ProgramFilesFolder: the plain Id is the
         32-BIT folder even in an -arch x64 package — the v0.9.0-rc.1
         install landed in "Program Files (x86)" on a real machine before
         this was caught. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Loombre">
        <!-- ARCHIVED-PAYLOAD MODEL (see Files.wxs's header): the five big
             trees below (server, worker, web, node, pg) are NOT installed
             by MSI components — they are the top-level names inside
             payload.zip (PAYLOADDIR), materialized here at INSTALL time
             by Package.wxs's ca.ExtractPayload (LoombreServiceHost.exe
             in extract-cli mode; first service start self-heals via the
             same extractor) and removed at uninstall by Package.wxs's cleanup component
             (util:RemoveFolderEx over the whole install folder). Their
             Directory Ids remain REAL and load-bearing: Services.wxs's
             [SERVERDIR]/[WORKERDIR]/[NODEDIR] Formatted-string references
             resolve exactly these paths, which is what keeps zip layout,
             extraction output, and service command lines from drifting
             apart. -->
        <!-- @loombre/server's `tsc` build output + pruned production
             node_modules (staged by the pnpm-deploy step — see
             build-msi.mjs's pnpmDeploy()). Contains dist/main.js, the
             ServiceHost wrapper's target executable argument (Services.wxs). -->
        <Directory Id="SERVERDIR" Name="server" />
        <!-- Same shape as SERVERDIR, for @loombre/worker. -->
        <Directory Id="WORKERDIR" Name="worker" />
        <!-- @loombre/web's production build output. STAGED HERE, NOT YET
             SERVABLE STANDALONE — see build-msi.mjs's header comment and
             the I3 lane report: apps/web/next.config.mjs does not set
             `output: 'standalone'` and apps/server has no code today that
             mounts/proxies a built Next app, even though
             packages/controller-ipc's IpcStatusResponse.webUrl (a bare URL,
             not a third ProcessInfo) implies "the server serves the web
             client" is the intended v1 architecture. Flagged, not invented
             here — installers/windows/msi is a staging/authoring lane, not
             the owner of apps/server or apps/web. -->
        <Directory Id="WEBDIR" Name="web" />
        <!-- Bundled Node runtime (single Node runtime per platform, no
             user-installed Node — docs/PLAN.md §11). NOT YET REAL: this
             lane's own build-msi.mjs (fetchNodeRuntime()) stages a
             PLACEHOLDER only — no shared fetch-node script exists in the
             repo yet, unlike ffmpeg/embedded-pg below. Flagged as a
             consolidation candidate for lane I in the I3 report (this
             lane does not own root scripts/, so it did not create one
             unilaterally). -->
        <Directory Id="NODEDIR" Name="node" />
        <!-- Bundled ffmpeg/ffprobe. Populated by lane I1's SHARED, landed
             scripts/fetch-ffmpeg.mjs — build-msi.mjs's fetchFfmpegWindows()
             calls its real CLI to fetch the pinned windows-x64 pair (see
             installers/ffmpeg-manifest.json). Falls back to a placeholder
             + a loud report note only if that script is ever absent. -->
        <Directory Id="FFMPEGDIR" Name="ffmpeg" />
        <!-- Embedded PostgreSQL per-platform pinned binaries (P4.2).
             Populated by lane B's SHARED, landed
             scripts/fetch-embedded-pg.mjs (same real-CLI /
             placeholder-fallback pattern as FFMPEGDIR). -->
        <Directory Id="PGDIR" Name="pg" />
        <!-- The single-file archived payload (payload.zip) holding the
             five big trees above — the ONLY thing the MSI installs for
             them (Files.wxs PayloadFiles; extracted by
             LoombreServiceHost, see the block comment at the top of
             INSTALLFOLDER). -->
        <Directory Id="PAYLOADDIR" Name="payload" />
        <!-- installers/windows/service-host's self-contained single-file
             win-x64 publish output (LoombreServiceHost.exe) — see
             Services.wxs for why this wrapper exists and is not just
             node.exe registered directly. -->
        <Directory Id="SVCHOSTDIR" Name="svc" />
        <!-- installers/windows/tray's self-contained single-file win-x64
             publish output (Loombre.Tray.exe). -->
        <Directory Id="TRAYDIR" Name="tray" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <!-- %ProgramData%\Loombre — the ProvisioningInterface data-dir
           (packages/provisioning/src/provisioning-request.ts's `dataDir`;
           packages/controller-ipc/src/transport.ts's discovery/token
           files live directly in this folder, alongside — not inside —
           APPDATA_DATA, matching transport.ts's "alongside the data dir
           itself" wording). -->
      <Directory Id="APPDATAFOLDER" Name="Loombre">
        <!-- Embedded-PG data directory + any other persistent server data
             (ProvisioningRequest.dataDir target). -->
        <Directory Id="APPDATA_DATA" Name="data" />
        <!-- LoombreServiceHost's child-process stdout/stderr logs
             (Services.wxs) + P4.5/P4.14 process-level crash files (the
             controller-ipc crash-files.ts surface reads from here). -->
        <Directory Id="APPDATA_LOGS" Name="logs" />
        <!-- P4.2 embedded-PG cluster data (kept as its own named
             subdirectory rather than dumped straight into APPDATA_DATA so
             a P4.3 dump/restore upgrade job can rsync/replace exactly this
             one directory without touching sibling app data). -->
        <Directory Id="APPDATA_PGDATA" Name="pgdata" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="APPLICATIONPROGRAMSFOLDER" Name="Loombre" />
    </StandardDirectory>
  </Fragment>
</Wix>
