<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Loombre __VERSION__</title>
    <organization>com.loombre</organization>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <!-- hostArchitectures: without it Installer assumes x86_64 and runs
         the install scripts under Rosetta on Apple Silicon (observed in
         the v0.9.0-rc.1 install log). This payload is arm64-only — say
         so, which also makes Installer refuse cleanly on Intel Macs
         instead of laying down binaries that cannot run. -->
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="arm64"/>
    <welcome file="welcome.txt" mime-type="text/plain"/>
    <readme file="readme.txt" mime-type="text/plain"/>
    <!-- The final pane. Added after the rc.1 field report ("the install
         will be successful but nothing happens nor opens"): the stack came
         up correctly every time, but Installer's last screen said only
         "The installation was successful" and the operator was left with
         no URL, no window, and no way to tell a working install from a
         dead one. This pane names the URL and the menu bar item that
         postinstall has just started. -->
    <conclusion file="conclusion.txt" mime-type="text/plain"/>

    <!--
      UNSIGNED build (P4.1 — no Apple notarization/Developer ID anywhere in
      this lane). Gatekeeper WILL block first-open; see docs/install/macos.md
      for the full walkthrough. This is documented, not hidden.
    -->

    <choices-outline>
        <line choice="com.loombre.choice"/>
    </choices-outline>
    <choice id="com.loombre.choice" title="Loombre Server" visible="false">
        <pkg-ref id="com.loombre.pkg"/>
    </choice>
    <pkg-ref id="com.loombre.pkg" version="__VERSION__" onConclusion="none">__PKG_FILENAME__</pkg-ref>
</installer-gui-script>
