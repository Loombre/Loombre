#!/bin/sh
# Loombre :: installers/macos/pkg/scripts/preinstall
#
# Runs before the payload is laid down. On a fresh install there is nothing
# to stop (idempotent no-op — all three `launchctl bootout` calls below are
# allowed to fail, that IS "nothing was running"). On an upgrade, stops any
# already-running server/worker/web LaunchDaemons so the new payload doesn't
# land under a live, possibly-incompatible process (mid-transcode ffmpeg
# processes, open DB connections against a schema about to be migrated,
# etc.) — installer runs this as root, which is required for
# `launchctl bootout system/...`.
set -u

SERVER_LABEL="system/com.loombre.server"
WORKER_LABEL="system/com.loombre.worker"
# Third daemon (installer completeness audit): the web-UI service must be
# stopped for upgrade too, or the new payload lands under a live Next
# server holding open file handles into the old version dir.
WEB_LABEL="system/com.loombre.web"

for LABEL in "$SERVER_LABEL" "$WORKER_LABEL" "$WEB_LABEL"; do
  if launchctl print "$LABEL" >/dev/null 2>&1; then
    echo "loombre preinstall: stopping $LABEL for upgrade"
    launchctl bootout "$LABEL" 2>/dev/null || true
  else
    echo "loombre preinstall: $LABEL not loaded (fresh install or already stopped)"
  fi
done

# The menubar app is a LaunchAGENT in the console user's GUI domain, not a
# system daemon, so it needs its own bootout with that user's uid — the
# system-domain loop above cannot see it. Left running, the old
# Loombre.app binary would be replaced underneath a live process, and the
# stale menu bar item would keep polling with the previous build's IPC
# expectations until the user logged out. Best-effort throughout: no
# console user (installing over SSH / at the login window) simply means
# there is no GUI session holding the bundle open.
CONSOLE_UID="$(stat -f %u /dev/console 2>/dev/null || echo 0)"
if [ "${CONSOLE_UID:-0}" -gt 0 ]; then
  if launchctl print "gui/${CONSOLE_UID}/com.loombre.menubar" >/dev/null 2>&1; then
    echo "loombre preinstall: stopping gui/${CONSOLE_UID}/com.loombre.menubar for upgrade"
    launchctl bootout "gui/${CONSOLE_UID}/com.loombre.menubar" 2>/dev/null || true
  else
    echo "loombre preinstall: com.loombre.menubar not loaded for uid ${CONSOLE_UID}"
  fi
fi

exit 0
