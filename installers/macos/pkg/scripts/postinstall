#!/bin/sh
# Loombre :: installers/macos/pkg/scripts/postinstall
#
# Runs after the payload is laid down (pkgbuild --install-location /).
# 1. Creates the `_loombre` system service account + group if absent
#    (idempotent — a `dscl . -read` existence check first).
# 2. Creates/repairs ownership+mode on the app-data and log directories
#    (installers/macos/LAYOUT.md is the authoritative table).
# 3. Seeds config/loombre.env once (never overwritten on upgrade — an
#    operator's DATABASE_URL edits must survive a `pkg` upgrade).
# 4. Marks the bin/ shims + fetched runtime binaries executable (pkgbuild
#    payload permissions can be lossy across some staging tools; this is
#    belt-and-suspenders, cheap and idempotent), then touches
#    /opt/loombre/current's own mtime — BOM restoration would otherwise
#    replay the pkg's BUILD-time stamp on every install, which is not what
#    the menubar's per-install auto-open gate needs (see the touch -h
#    comment below, at the end of this step).
# 5. Bootstraps (loads) all three LaunchDaemons (server, worker, web UI)
#    so the service is live immediately, without requiring a reboot.
#
# Runs as root (Installer.app / `installer(8)` always run scripts as root).
set -eu

APP_SUPPORT="/Library/Application Support/Loombre"
LOG_DIR="/Library/Logs/Loombre"
OPT_DIR="/opt/loombre"

# --- 1. service account -----------------------------------------------
if ! dscl . -read /Users/_loombre >/dev/null 2>&1; then
  echo "loombre postinstall: creating _loombre service account"
  # Standard macOS "hidden system account" recipe (same shape as _postgres,
  # _www): UniqueID in the system range, no login shell, no real home dir.
  NEXT_UID=$(dscl . -list /Users UniqueID | awk '{print $2}' | awk '$1<500 && $1>200 {print}' | sort -n | tail -1)
  NEXT_UID=${NEXT_UID:-200}
  NEXT_UID=$((NEXT_UID + 1))

  dscl . -create /Users/_loombre
  dscl . -create /Users/_loombre UserShell /usr/bin/false
  dscl . -create /Users/_loombre RealName "Loombre Service Account"
  dscl . -create /Users/_loombre UniqueID "$NEXT_UID"
  dscl . -create /Users/_loombre PrimaryGroupID "$NEXT_UID"
  dscl . -create /Users/_loombre NFSHomeDirectory /var/empty
  dscl . -create /Groups/_loombre PrimaryGroupID "$NEXT_UID"
  dscl . -create /Groups/_loombre RealName "Loombre Service Group"
  # (installer completeness audit: this line shipped as `-appendo`, a typo
  # dscl reports as an unknown verb — masked by the `|| true`. `-append` is
  # the real verb. Harmless in practice only because _loombre's
  # PrimaryGroupID already makes it a member of its own primary group;
  # fixed anyway so the explicit membership record actually lands.)
  dscl . -append /Groups/_loombre GroupMembership _loombre 2>/dev/null || true
  # IsHidden keeps the account off the login window / Users & Groups list.
  dscl . -create /Users/_loombre IsHidden 1
else
  echo "loombre postinstall: _loombre service account already exists"
fi

# --- 2. directories ------------------------------------------------------
mkdir -p "$APP_SUPPORT/db" "$APP_SUPPORT/config" "$APP_SUPPORT/secrets" "$APP_SUPPORT/ipc"
mkdir -p "$LOG_DIR"

chown -R _loombre:_loombre "$APP_SUPPORT"

# ROOT dir only: group `admin` + 0750 — installer completeness audit.
# apps/server's IPC listener writes its discovery + bearer-token files
# (controller-ipc.json / controller-ipc.token) at the app-support ROOT
# (apps/server/src/ipc/discovery-files.ts follows the FROZEN transport.ts
# wording: "under the platform app-data dir", no subdirectory), each 0640
# with the file's GROUP chown'd to LOOMBRE_IPC_GROUP=admin (set by
# bin/loombre-server per the recorded orchestrator decision in
# apps/server/src/ipc/env.ts). The menubar app runs as the CONSOLE user,
# not _loombre — group-read on those files is useless unless that user can
# also TRAVERSE this directory, so the root dir itself must be group-admin
# 0750 (owner _loombre rwx, group admin r-x, no world bits).
#
# Deliberately NOT loosened (verified against what the server creates):
#   - postgres/  — embedded-PG data dir + superuser.secret; initdb itself
#     enforces 0700 on postgres/data and the secret is file0600
#     (packages/provisioning-pg/src/{discovery.ts,secret/file0600.ts}).
#   - secrets/   — 0700 below (P4.7 file0600 SecretRef fallback dir).
# Both stay _loombre-owned with no group access; only the ROOT dir's group
# changes here, never `chgrp -R`.
#
# Upgrade note: the `chown -R _loombre:_loombre` above resets any existing
# discovery/token files' group back to _loombre for a moment — harmless:
# preinstall already booted the daemons out, and the server rewrites both
# files (re-chowning group per LOOMBRE_IPC_GROUP) on every boot.
chown _loombre:admin "$APP_SUPPORT"
chmod 0750 "$APP_SUPPORT"
chmod 0750 "$APP_SUPPORT/db" "$APP_SUPPORT/ipc" "$APP_SUPPORT/config"
chmod 0700 "$APP_SUPPORT/secrets"

chown -R _loombre:_loombre "$LOG_DIR"
chmod 0755 "$LOG_DIR"

chown -R root:wheel "$OPT_DIR"

# --- 3. config seed (create-once, never clobber on upgrade) -------------
CONFIG_ENV="$APP_SUPPORT/config/loombre.env"
if [ ! -f "$CONFIG_ENV" ]; then
  cat > "$CONFIG_ENV" <<'EOF'
# Loombre service environment overrides.
# Sourced by /opt/loombre/current/bin/loombre-{server,worker,web} at every
# start. This file is created once at install time and NEVER touched by
# upgrades — edits here survive `pkg` reinstalls/upgrades.
#
# --- Database ---------------------------------------------------------
# Leave DATABASE_URL unset (the default) and the server provisions and
# supervises the BUNDLED embedded PostgreSQL under
# /Library/Application Support/Loombre/postgres/ automatically at boot.
# Embedded-mode knobs (port, version pinning, vendor dir) are the
# LOOMBRE_EMBEDDED_PG_* variables — see docs/install/macos.md and
# packages/provisioning-pg for the full list; bin/loombre-server derives
# sensible defaults from the payload itself.
#
# Uncomment and edit to point at your own PostgreSQL instead
# (D1: "external Postgres via one env var" is a first-class, equally
# tested path — see docs/install/macos.md):
#
#   DATABASE_URL=postgres://loombre:yourpassword@127.0.0.1:5432/loombre
#
# --- Ports ------------------------------------------------------------
# A bare PORT here is the API SERVER's port (bin/loombre-server defaults
# it to 3001):
#
#   PORT=3001
#
# The web UI's port is deliberately NAMESPACED — all three services source
# this same file, and Next's standalone server also reads a bare PORT, so
# an un-namespaced value would move/collide both services at once.
# bin/loombre-web maps LOOMBRE_WEB_PORT onto PORT after sourcing:
#
#   LOOMBRE_WEB_PORT=3000
#   LOOMBRE_WEB_HOSTNAME=0.0.0.0   # web UI bind address (127.0.0.1 = local only)
#
# --- LAN access -------------------------------------------------------
# The API's CORS allowlist defaults to http://localhost:3000 +
# http://127.0.0.1:3000 ONLY (apps/server). The web UI binds all
# interfaces, but browsing it from another device needs the origins those
# browsers will actually use allowlisted, comma-separated:
#
#   LOOMBRE_CORS_ORIGINS=http://mymac.local:3000,http://192.168.1.50:3000
#
# and the web app told which API origin those browsers should reach
# (defaults to http://localhost:3001, correct only on the Mac itself):
#
#   LOOMBRE_SERVER_ORIGIN=http://mymac.local:3001
EOF
  chown _loombre:_loombre "$CONFIG_ENV"
  chmod 0640 "$CONFIG_ENV"
fi

# --- 4. executable bits ---------------------------------------------------
chmod 0755 "$OPT_DIR/current/bin/loombre-server" "$OPT_DIR/current/bin/loombre-worker" "$OPT_DIR/current/bin/loombre-web" 2>/dev/null || true
chmod 0755 "$OPT_DIR/current/runtime/node/bin/node" 2>/dev/null || true
chmod 0755 "$OPT_DIR/current/runtime/ffmpeg/ffmpeg" "$OPT_DIR/current/runtime/ffmpeg/ffprobe" 2>/dev/null || true

# `current` ships as PART OF THE PKG PAYLOAD (build-pkg.mjs lays the
# symlink down at build time) — it is never created here. Its BOM entry
# therefore carries the pkg's BUILD timestamp, and macOS's installer
# restores BOM mtimes on every run. Left alone, re-running the SAME pkg
# (a plain reinstall, no new build) would stamp the IDENTICAL mtime every
# time, and the menubar's per-install auto-open gate
# (LoombreIPCKit/InstallStamp.swift, keyed by MenuState.shouldAutoOpenWeb)
# reads exactly that mtime as "which install is this" — so without this
# touch, auto-open semantics would silently become once-per-pkg-BUILD
# instead of once-per-INSTALL, and every reinstall of the same download
# would stay stuck as "already opened." `-h` touches the symlink's own
# timestamp (lstat semantics), not the versioned directory it resolves to —
# matching exactly how InstallStamp.swift reads it.
touch -h "$OPT_DIR/current" 2>/dev/null || true

# --- 5. load the daemons ---------------------------------------------------
# Order matters loosely: server first (it provisions embedded PG + writes
# the IPC discovery files), then worker (discovers DATABASE_URL via
# LOOMBRE_DATA_DIR), then web (com.loombre.web — installer completeness
# audit gap 1: the UI daemon, serving the Next standalone build on :3000).
for PLIST in /Library/LaunchDaemons/com.loombre.server.plist /Library/LaunchDaemons/com.loombre.worker.plist /Library/LaunchDaemons/com.loombre.web.plist; do
  if [ -f "$PLIST" ]; then
    echo "loombre postinstall: bootstrapping $PLIST"
    launchctl bootstrap system "$PLIST" 2>&1 || echo "loombre postinstall: WARNING bootstrap failed for $PLIST (may already be loaded)"
  fi
done

# --- 6. show the operator that something happened --------------------------
# THE rc.1 FIELD BUG: everything above this line worked perfectly — server,
# worker, web UI and embedded PostgreSQL all came up — and the operator's
# entire experience was a progress bar reaching 100% and then nothing. No
# window, no menu bar item, no indication the machine was now running a
# media server. Loombre.app sat in /Applications, launched by nobody.
#
# `launchctl bootstrap gui/<uid>` is the documented way for a root-context
# installer to load an agent into a live login session; it both starts the
# app NOW and (because the plist lives in /Library/LaunchAgents with
# RunAtLoad) registers it for every future login, on every account.
#
# Everything here is best-effort by design — a failure to raise the UI must
# never fail an install whose services are already running:
#   - No console user at all (`installer -pkg` over SSH, or sitting at the
#     login window) => CONSOLE_UID is 0/root and we skip. The agent still
#     loads by itself the next time somebody logs in, which is the whole
#     point of putting it in /Library/LaunchAgents.
#   - Already bootstrapped (re-running the installer without a logout)
#     => bootstrap exits non-zero with "service already loaded"; the
#     preceding bootout makes that path rare, and it is harmless anyway.
MENUBAR_AGENT="/Library/LaunchAgents/com.loombre.menubar.plist"
CONSOLE_UID="$(stat -f %u /dev/console 2>/dev/null || echo 0)"
if [ -f "$MENUBAR_AGENT" ] && [ "${CONSOLE_UID:-0}" -gt 0 ]; then
  echo "loombre postinstall: starting the menubar app for uid ${CONSOLE_UID}"
  launchctl bootout "gui/${CONSOLE_UID}/com.loombre.menubar" 2>/dev/null || true
  launchctl bootstrap "gui/${CONSOLE_UID}" "$MENUBAR_AGENT" 2>&1 ||
    echo "loombre postinstall: WARNING could not bootstrap the menubar agent — it will load at the next login"
else
  echo "loombre postinstall: no console user (uid=${CONSOLE_UID}) — the menubar agent will load at the next login"
fi

exit 0
