#!/bin/sh
# Loombre :: /opt/loombre/current/bin/loombre-worker
#
# See bin/loombre-server for the config/loombre.env rationale AND the
# `pwd -P` (not plain `pwd`) rationale — identical pattern, worker side.
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd -P)"
CONFIG_ENV="/Library/Application Support/Loombre/config/loombre.env"

# shellcheck disable=SC1090
[ -f "$CONFIG_ENV" ] && { set -a; . "$CONFIG_ENV"; set +a; }

: "${LOOMBRE_FFMPEG:=$HERE/runtime/ffmpeg/ffmpeg}"
: "${LOOMBRE_FFPROBE:=$HERE/runtime/ffmpeg/ffprobe}"
export LOOMBRE_FFMPEG LOOMBRE_FFPROBE

# LOOMBRE_LOG_FILE (LD-11): see bin/loombre-server's comment — same
# rationale, pointed at com.loombre.worker.plist's own StandardOutPath.
export LOOMBRE_LOG_FILE="${LOOMBRE_LOG_FILE:-/Library/Logs/Loombre/worker.out.log}"

# No DATABASE_URL default (the rc.1 dev-only localhost:5442 default made
# the worker crash-loop on every real Mac). Unset + LOOMBRE_DATA_DIR set
# means the worker DISCOVERS the embedded credentials apps/server's
# provisioner writes (P4.2 discovery seam, apps/worker/src/db-url.ts):
# it polls boundedly for the superuser secret, then connects. Operators
# who want external mode set DATABASE_URL in config/loombre.env (sourced
# above), which always wins.
if [ -n "${DATABASE_URL:-}" ]; then
  export DATABASE_URL
fi
: "${LOOMBRE_DATA_DIR:=/Library/Application Support/Loombre}"
export LOOMBRE_DATA_DIR

exec "$HERE/runtime/node/bin/node" "$HERE/worker/dist/index.js"
