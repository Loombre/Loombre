#!/bin/sh
# Loombre :: /opt/loombre/current/bin/loombre-web
#
# Launched by /Library/LaunchDaemons/com.loombre.web.plist. NEW in the
# installer completeness audit (gap 1): earlier payloads shipped NO web UI
# at all — the readme even pointed users at http://localhost:3001, which is
# the API, not a UI. build-pkg.mjs's stageWeb() now stages apps/web's Next
# `output: "standalone"` build under <version>/web/ (monorepo layout:
# web/apps/web/server.js + web/node_modules), and this shim runs it on the
# bundled Node runtime.
#
# See bin/loombre-server for the config/loombre.env rationale AND the
# `pwd -P` (not plain `pwd`) rationale — identical pattern, web side.
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd -P)"
CONFIG_ENV="/Library/Application Support/Loombre/config/loombre.env"

# shellcheck disable=SC1090
# shellcheck disable=SC1090
[ -f "$CONFIG_ENV" ] && { set -a; . "$CONFIG_ENV"; set +a; }

# PORT NAMESPACE COLLISION (installer completeness audit): all three shims
# (loombre-server, loombre-worker, loombre-web) source the SAME
# config/loombre.env, and a bare PORT there is the SERVER's API port
# (bin/loombre-server's `: "${PORT:=3001}"` contract — its plist/env story
# predates this shim and operators may already rely on it). Next's
# standalone server.js ALSO reads a bare PORT env var — so if this shim
# honored the sourced PORT directly, setting the server's port in
# loombre.env would silently move the web UI too (or collide outright).
# The web UI's port is therefore namespaced as LOOMBRE_WEB_PORT in
# loombre.env (see postinstall's seeded comments), and mapped onto the PORT
# variable Next actually reads ONLY here, AFTER sourcing — deliberately
# clobbering any server-intended PORT value the env file just set.
PORT="${LOOMBRE_WEB_PORT:-3000}"

# HOSTNAME is Next standalone's bind-address env var. 0.0.0.0 (all
# interfaces) because "reachable from the couch/another device on the LAN"
# is the point of a media server's web UI — but note the API's CORS
# allowlist defaults to localhost:3000 only, so LAN use also needs
# LOOMBRE_CORS_ORIGINS set in loombre.env (see its seeded comments).
# LOOMBRE_WEB_HOSTNAME is the namespaced override (same collision logic as
# LOOMBRE_WEB_PORT above — HOSTNAME is too generic a name to trust from a
# shared env file) for operators who want loopback-only binding.
HOSTNAME="${LOOMBRE_WEB_HOSTNAME:-0.0.0.0}"

NODE_ENV=production

# Which API origin the web app's per-request CSP allows the browser to
# connect to (apps/web/src/lib/csp.ts's LOOMBRE_SERVER_ORIGIN <->
# LOOMBRE_CORS_ORIGINS pairing). Default matches bin/loombre-server's
# default PORT=3001 on the same host. An operator override sourced from
# loombre.env wins via the :- expansion.
LOOMBRE_SERVER_ORIGIN="${LOOMBRE_SERVER_ORIGIN:-http://localhost:3001}"

# LOOMBRE_LOG_FILE (LD-11): see bin/loombre-server's comment — same
# rationale, pointed at com.loombre.web.plist's own StandardOutPath. Not
# consumed by anything today (the log-tail card only reads the SERVER
# process's own env — apps/server/src/catalog/admin-logs-tail.ts), set
# here for consistency and any future per-process log surface.
LOOMBRE_LOG_FILE="${LOOMBRE_LOG_FILE:-/Library/Logs/Loombre/web.out.log}"

export PORT HOSTNAME NODE_ENV LOOMBRE_SERVER_ORIGIN LOOMBRE_LOG_FILE

# Monorepo standalone layout: the entry point is apps/web/server.js INSIDE
# the staged standalone root, not server.js at its top level — see
# build-pkg.mjs stageWeb().
exec "$HERE/runtime/node/bin/node" "$HERE/web/apps/web/server.js"
