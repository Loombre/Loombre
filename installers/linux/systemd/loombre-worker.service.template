[Unit]
Description=Loombre background worker (scan/probe/transcode/metadata/import jobs)
Documentation=https://github.com/Loombre/Loombre
After=network.target network-online.target loombre-server.service
Wants=network-online.target

[Service]
Type=simple
User=__LOOMBRE_USER__
Group=__LOOMBRE_USER__
EnvironmentFile=__CONFIG_DIR__/loombre.env
WorkingDirectory=__DATA_DIR__
ExecStart=__PREFIX__/bin/loombre-worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# KillMode=mixed — see loombre-server.service.template: SIGTERM reaches
# node alone (the log tee and any ffmpeg helper are reaped after it
# exits), so a clean stop no longer files an EPIPE crash report.
KillMode=mixed

# Hardening — mirrors loombre-server.service.template; see that file for
# rationale. ReadWritePaths covers the same data dir (scan/transcode
# output, blurhash cache, hwcaps snapshots all live under it).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=__DATA_DIR__
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# MemoryDenyWriteExecute is DELIBERATELY ABSENT — incompatible with V8's
# JIT (systemd.exec(5) says so explicitly for JIT runtimes); see the
# fuller note in loombre-server.service.template.
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
