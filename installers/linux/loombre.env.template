# Loombre environment file — generated from installers/linux/
# loombre.env.template by the installer that put it here (the tarball's
# install.sh, or the .rpm/.deb package). Values here are read by
# loombre-server, loombre-worker AND loombre-web (systemd's
# EnvironmentFile=, or sourced directly in --no-systemd mode).

# Server HTTP port.
PORT=3001

NODE_ENV=production

# App-data directory (matches the --data-dir this was installed with).
LOOMBRE_DATA_DIR=__DATA_DIR__

# PostgreSQL. Leave DATABASE_URL unset (the default) to use the BUNDLED
# embedded PostgreSQL: the server provisions it under the data dir, runs
# migrations automatically at boot, and supervises it — no database setup
# of any kind required. Uncomment and point at your own Postgres 17+
# instance for external mode instead (P4.2's "external-PG env var path" —
# first-class and equally tested; you run migrations yourself in that mode,
# see docs/install/linux.md).
#DATABASE_URL=postgres://loombre:CHANGE_ME@127.0.0.1:5432/loombre

# JWT signing secret. STRONGLY recommended to set explicitly in any real
# deployment — without it the server falls back to an EPHEMERAL per-process
# secret (every restart logs every device out). Generate one with:
#   openssl rand -base64 48
#LOOMBRE_JWT_SECRET=

# Web client (bin/loombre-web / loombre-web.service) HTTP port. NOT the
# shared PORT above — that one belongs to loombre-server; the web wrapper
# reads this and defaults to 3000.
#LOOMBRE_WEB_PORT=3000

# Reverse-proxy deployments: uncomment if loombre-server sits behind your
# own trusted reverse proxy (nginx/Caddy/Traefik) that sets X-Forwarded-For.
#LOOMBRE_TRUST_PROXY=loopback

# CORS allow-list for the web client, comma-separated. Empty disables CORS
# entirely (same-origin deployments behind one reverse proxy). For LAN use
# — browsing from other machines — list the web client's URL as those
# machines actually reach it (host/IP + LOOMBRE_WEB_PORT), e.g.:
#   LOOMBRE_CORS_ORIGINS=http://localhost:3000,http://192.168.1.50:3000
#LOOMBRE_CORS_ORIGINS=http://localhost:3000

# The web client's Content-Security-Policy pairs with the line above: it
# lets the browser call ONLY this API origin (bin/loombre-web defaults it
# to http://localhost:3001). For LAN use set it to the API origin those
# machines reach — the same host as in LOOMBRE_CORS_ORIGINS, port 3001:
#LOOMBRE_SERVER_ORIGIN=http://192.168.1.50:3001

# Embedded PostgreSQL (ADVANCED — normally all auto). When DATABASE_URL is
# unset, bin/loombre-server points the vendor dir at the installed pg/
# payload and derives the version from it; the cluster listens on
# localhost:5433. Only override to run a self-vendored PG build/version or
# to move the port:
#LOOMBRE_EMBEDDED_PG_VENDOR_DIR=__PREFIX__/pg
#LOOMBRE_EMBEDDED_PG_VERSION=
#LOOMBRE_EMBEDDED_PG_PORT=5433

# Performance tier: "0", "1" or "2" (docs/PLAN.md §9.1). UNSET MEANS TIER 0
# — there is no autodetection — and Tier 0 is the small-box posture
# (N100 / Pi 5 class): at most 2 conversions at once, a capped ladder, and
# NO processor-based HDR tone-mapping for 1080p and above — so on a host
# whose hardware self-test verified no tone-map method (the common case on
# Linux today), every HDR title is refused as unplayable. On a desktop- or
# server-class machine set 2 (1 for a mid-range box) and restart
# loombre-server; the admin setting transcode.allowToneMapCpu=always is
# the no-restart alternative for the HDR case alone.
#LOOMBRE_TIER=2

# Library folders on NAS/network mounts (NFS/SMB) often don't deliver
# inotify events — set LOOMBRE_SCAN_POLL=1 to force polling for watched
# paths if new files aren't picked up automatically.
#LOOMBRE_SCAN_POLL=1

# Transcode staging: where in-flight HLS segments live while a video is
# being converted. The bin/ wrappers default this to <data dir>/transcode
# — it MUST be a directory BOTH loombre-server and loombre-worker can see
# and write: the units run with PrivateTmp=true, so anything under /tmp is
# private to each service and playback never starts. To move it (an NVMe
# or tmpfs path), set it here AND add a `ReadWritePaths=<that path>`
# drop-in to both units (`systemctl edit loombre-server`, then
# loombre-worker) — the units are ProtectSystem=strict.
#LOOMBRE_TRANSCODE_DIR=__DATA_DIR__/transcode

# Desktop tray (bin/loombre-tray) — controller IPC. The server writes a
# discovery file + bearer token that the tray reads, under /run/loombre.
# The server unit's root-run ExecStartPre step (bin/loombre-ipc-dir-setup)
# creates that directory and hands it to the host's local-administrator
# group (the first of wheel, sudo, admin that exists), setgid, so the
# files inherit the group and an administrator's desktop session can
# connect. Override the group to grant
# a different one (its members can stop the server and list crash files
# from the tray — nothing more); it must exist on this host.
#LOOMBRE_IPC_GROUP=wheel
#LOOMBRE_IPC_DIR=/run/loombre
# Headless host with no desktop: turn the IPC listener off entirely.
#LOOMBRE_IPC_DISABLED=1
