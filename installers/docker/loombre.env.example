# Loombre :: installers/docker/loombre.env.example
#
# Copy this file to `loombre.env` (same directory), fill in the values
# marked REQUIRED, then run compose with:
#
#   docker compose -f docker-compose.prod.yml --env-file installers/docker/loombre.env up -d
#
# `loombre.env` itself is gitignored (see .dockerignore/.gitignore) — never
# commit real secrets. Every variable docker-compose.prod.yml reads is
# documented below; anything left unset falls back to the default noted.

# ─────────────────────────────────────────────────────────────────────────
# Postgres (docker-compose.prod.yml's `postgres` service)
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED. No default — compose refuses to start without this set.
POSTGRES_PASSWORD=

# Optional. Database/role name inside the postgres container. Change these
# together with DATABASE_URL below if you point at an external Postgres
# instead of the bundled one (see "External Postgres" in docs/install/docker.md).
POSTGRES_DB=loombre
POSTGRES_USER=loombre

# ─────────────────────────────────────────────────────────────────────────
# Server + worker — required
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED. Signs access JWTs (docs/PLAN.md §10). If unset, the server
# derives a random secret EVERY PROCESS START and logs a loud warning —
# every previously issued access token is invalidated on every restart,
# and the server and worker processes (which both need to agree on this
# value for any multi-process deployment) would silently disagree. Generate
# one with: `openssl rand -base64 48`
LOOMBRE_JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Server — networking / remote access (docs/PLAN.md §10, README.md's
# "Remote access" section — same posture applies to the Docker path)
# ─────────────────────────────────────────────────────────────────────────

# Host port the server's HTTP API is published on (container-internal PORT
# matches this same value — see docker-compose.prod.yml). Default 3001
# matches the server's own built-in default (apps/server/src/main.ts).
# Real deployments should NOT expose this directly to the internet — put a
# reverse proxy in front (80/443 + TLS) and leave this bound to localhost/
# your LAN. See docs/install/docker.md.
LOOMBRE_PORT=3001

# Comma-separated allowed CORS origins for the web client. Empty disables
# CORS entirely (same-origin deployments behind one reverse proxy — the
# recommended posture once you have one). Unset falls back to the
# localhost:3000 dev pairing, which is almost never what a deployed
# instance wants — set this explicitly once you know your web client's
# real origin.
LOOMBRE_CORS_ORIGINS=

# Set ONLY when running behind a reverse proxy YOU control that strips/
# overwrites incoming X-Forwarded-For before adding its own (nginx/Caddy/
# Traefik in front of this compose stack). Values: "1" (trust one hop),
# an Express preset ("loopback"), or a CIDR list ("10.0.0.0/8"). Leaving
# this unset is safe with no configuration — see README.md's "Remote
# access" section for why setting it WITHOUT a real proxy in front is a
# spoofing risk.
LOOMBRE_TRUST_PROXY=

# ─────────────────────────────────────────────────────────────────────────
# Server — performance tier + playback policy (docs/PLAN.md §9.2)
# ─────────────────────────────────────────────────────────────────────────

# "0" | "1" | "2" (docs/PLAN.md §9.1 hardware tiers). Unset = server infers
# defaults from resolved capabilities rather than a fixed tier. Set this
# explicitly if you know your host is Tier-0 class (N100/Pi-5/4 GB RAM) so
# concurrency caps and the transcode ladder default conservatively without
# needing a first-boot probe to discover that.
LOOMBRE_TIER=

# "true" | "false". Unset = transcoding allowed (subject to
# LOOMBRE_MAX_TRANSCODES and the resolved hardware capabilities). Set to
# "false" to force direct-play-only (e.g. a box with no usable hw encoder
# and CPU headroom you don't want transcoding to consume).
LOOMBRE_ALLOW_TRANSCODE=

# Positive integer. Overrides the tier-derived default for how many
# simultaneous transcode sessions the server will admit (429 beyond this —
# docs/PLAYBACK.md §9). Unset = tier default.
LOOMBRE_MAX_TRANSCODES=

# Positive integer, bits per second. Caps every session's selected
# bitrate regardless of what the client's DeviceProfile/network conditions
# would otherwise allow. Unset = no server-side cap (device/network only).
LOOMBRE_MAX_STREAM_BITRATE=

# "true" | "false" (default off). Gate-1 capability flag (STATE.md P1.19)
# — while off, restricted-content code paths stay inert and restricted
# libraries cannot be created at all. Read docs/PLAN.md §6.4 before
# enabling on a shared/family instance.
LOOMBRE_RESTRICTED_ENABLED=

# ─────────────────────────────────────────────────────────────────────────
# Worker — scan/transcode concurrency (docs/PLAN.md §9.2 per-tier caps)
# ─────────────────────────────────────────────────────────────────────────

# Positive integer. Hash-pool / probe-job concurrency. Unset = auto:
# max(2, detected_cpu_count / 2).
LOOMBRE_SCAN_CONCURRENCY=

# Positive integer. How many 'transcode' jobs THIS worker process runs
# concurrently (a soft cap on top of the server's own admission control —
# see LOOMBRE_MAX_TRANSCODES above, which is the REAL limit). Unset = 8.
LOOMBRE_TRANSCODE_WORKER_CONCURRENCY=

# Integer 1-1000, milliseconds. Poll interval for each active transcode
# session's throttle/seek control loop. Unset = 250. You should not need
# to change this.
LOOMBRE_TRANSCODE_POLL_MS=

# ─────────────────────────────────────────────────────────────────────────
# ffmpeg/ffprobe overrides
# ─────────────────────────────────────────────────────────────────────────
#
# The image already vendors a pinned, checksum-verified static ffmpeg/
# ffprobe pair for its own architecture at build time (installers/
# ffmpeg-manifest.json, fetched by scripts/fetch-ffmpeg.mjs) and sets
# LOOMBRE_FFMPEG=/usr/local/bin/ffmpeg / LOOMBRE_FFPROBE=/usr/local/bin/ffprobe
# in the Dockerfile — you do not need to set these to get a working
# instance. They exist here as an ESCAPE HATCH: if you need a build with
# hardware-acceleration support the vendored binary lacks (VAAPI on a
# specific GPU, NVENC against host NVIDIA drivers you've bind-mounted in,
# etc.), bind-mount your own ffmpeg/ffprobe into the container and point
# these at that path. Uncomment and adjust both together:
# LOOMBRE_FFMPEG=/usr/local/bin/ffmpeg
# LOOMBRE_FFPROBE=/usr/local/bin/ffprobe

# ─────────────────────────────────────────────────────────────────────────
# Worker — metadata providers (docs/PLAN.md §8.3, STATE.md P1.9). Both
# optional — the worker boots and scans fine with neither set; the
# corresponding provider just registers as disabled (logged at boot, and
# surfaced to admins via GET /system/capabilities). MusicBrainz needs no
# key at all.
# ─────────────────────────────────────────────────────────────────────────
LOOMBRE_TMDB_API_KEY=
LOOMBRE_TVDB_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Advanced / rarely needed
# ─────────────────────────────────────────────────────────────────────────

# Compose project name — changes the named-volume prefix (loombre_pgdata,
# loombre_data become <name>_pgdata/<name>_data) and container name prefix.
# Only relevant if you're running more than one Loombre stack on the same
# Docker host. Default: "loombre".
# COMPOSE_PROJECT_NAME=loombre

# Overrides the image tag docker-compose.prod.yml's `server`/`worker`
# services run (both from the SAME image — see the Dockerfile's header
# comment for why). Only needed if you're pulling a specific published
# tag instead of building locally (`docker compose build`).
# LOOMBRE_IMAGE=loombre:latest
