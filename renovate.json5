// SPDX-License-Identifier: AGPL-3.0-only
// Loombre :: renovate.json5 — continuous dependency currency (N7, supported-
// latest sweep 2026-07-25). This config exists so that sweep is the LAST
// manual one: minors/patches arrive grouped weekly, majors arrive as
// individual PRs (mirroring the sweep's own N3 policy), lockfile maintenance
// runs weekly, and GitHub Actions stay digest-pinned (the security review's
// supply-chain posture — Renovate updates the pinned SHA and keeps the
// human-readable version comment).
//
// DELIBERATELY NOT AUTO-TRACKED (checksum-bearing vendor manifests whose
// values are only valid together with their sha256 fields, produced by the
// verified fetch flows — a half-bumped manifest is worse than a stale one):
//   installers/linux/node-manifest.json   (scripts in installers/linux)
//   installers/embedded-pg-manifest.json  (scripts/fetch-embedded-pg.mjs)
//   installers/ffmpeg-manifest.json       (scripts/fetch-ffmpeg.mjs)
// The same versions ARE tracked where no checksum rides along (.nvmrc,
// Dockerfile FROM tags, compose postgres tags, engines) — when those PRs
// land, refresh the matching manifest via its fetch script in the same PR.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'group:allNonMajor',
    ':separateMajorReleases',
    ':maintainLockFilesWeekly',
    'helpers:pinGitHubActionDigests',
    'schedule:weekly',
  ],
  // Pre-releases are banned tree-wide (N2 policy; scripts/grep-gates.mjs
  // enforces it against the lockfile). ignoreUnstable is Renovate's default
  // but stated here because it is policy, not preference.
  ignoreUnstable: true,
  // Supply-chain smoke margin: let the ecosystem find a hijacked release
  // before we install it.
  minimumReleaseAge: '3 days',
  packageRules: [
    {
      // TypeScript 7.x (native compiler) is evidence-blocked until the 7.1
      // programmatic API ships AND typescript-eslint + Next support it —
      // see STATE.md's supported-latest sweep ledger. Remove this cap when
      // those land; until then a TS7 PR would just fail the gate's lint.
      matchPackageNames: ['typescript'],
      allowedVersions: '<7',
    },
    {
      // N2 runtime policy: Node ships Active-LTS only. Runtime-version PRs
      // (engines/.nvmrc/Dockerfile node tags) get a label so the LTS-only
      // rule is applied consciously at review — Renovate's `node`
      // versioning offers the updates; the policy decides which merge.
      matchDatasources: ['node-version', 'docker'],
      matchPackageNames: ['node'],
      addLabels: ['runtime-policy'],
    },
  ],
  customManagers: [
    {
      // OASDIFF_VERSION env pin, duplicated across ci.yml + release.yml by
      // design (their comments say keep in sync) — Renovate updates both.
      customType: 'regex',
      managerFilePatterns: ['/^\\.github/workflows/.*\\.ya?ml$/'],
      matchStrings: ['OASDIFF_VERSION: "(?<currentValue>[0-9.]+)"'],
      depNameTemplate: 'oasdiff/oasdiff',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
  ],
}
