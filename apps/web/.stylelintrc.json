{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "custom-property-pattern": null,
    "selector-class-pattern": null,
    "import-notation": null,
    "property-no-unknown": [
      true,
      { "ignoreProperties": ["composes"] }
    ],
    "property-no-vendor-prefix": [
      true,
      { "ignoreProperties": ["backdrop-filter"] }
    ],
    "declaration-property-value-allowed-list": {
      "/^border-radius$/": [
        "/^var\\(--radius-(pill|lg|md|sm|full)\\)$/",
        "/^var\\(--radius-(pill|lg|md|sm|full)\\) var\\(--radius-(pill|lg|md|sm|full)\\)( var\\(--radius-(pill|lg|md|sm|full)\\) var\\(--radius-(pill|lg|md|sm|full)\\))?$/",
        "/^calc\\(\\s*var\\(--radius-md\\)\\s*-\\s*7px\\s*\\)$/",
        "0",
        "inherit"
      ],
      "/^border-(top|bottom)-(left|right)-radius$/": [
        "/^var\\(--radius-(pill|lg|md|sm|full)\\)$/",
        "0",
        "inherit"
      ],
      "/^(gap|row-gap|column-gap)$/": [
        "/^(?:[\\d.]+(?:%|em)|0|auto|inherit|(?:var|env)\\([^()]*\\)|(?:calc|min|max|clamp)\\((?:[^()]|\\([^()]*\\))*var\\([^()]*\\)(?:[^()]|\\([^()]*\\))*\\))(?:\\s+(?:[\\d.]+(?:%|em)|0|auto|inherit|(?:var|env)\\([^()]*\\)|(?:calc|min|max|clamp)\\((?:[^()]|\\([^()]*\\))*var\\([^()]*\\)(?:[^()]|\\([^()]*\\))*\\)))?$/"
      ],
      "/^(margin|padding)$/": [
        "/^(?:[\\d.]+(?:%|em)|0|auto|inherit|(?:var|env)\\([^()]*\\)|(?:calc|min|max|clamp)\\((?:[^()]|\\([^()]*\\))*var\\([^()]*\\)(?:[^()]|\\([^()]*\\))*\\))(?:\\s+(?:[\\d.]+(?:%|em)|0|auto|inherit|(?:var|env)\\([^()]*\\)|(?:calc|min|max|clamp)\\((?:[^()]|\\([^()]*\\))*var\\([^()]*\\)(?:[^()]|\\([^()]*\\))*\\))){0,3}$/"
      ],
      "/^(margin|padding)-(top|right|bottom|left)$/": [
        "/^(?:[\\d.]+(?:%|em)|0|auto|inherit|(?:var|env)\\([^()]*\\)|(?:calc|min|max|clamp)\\((?:[^()]|\\([^()]*\\))*var\\([^()]*\\)(?:[^()]|\\([^()]*\\))*\\))$/"
      ],
      "/^(margin|padding)-(inline|block)$/": [
        "/^(?:[\\d.]+(?:%|em)|0|auto|inherit|(?:var|env)\\([^()]*\\)|(?:calc|min|max|clamp)\\((?:[^()]|\\([^()]*\\))*var\\([^()]*\\)(?:[^()]|\\([^()]*\\))*\\))(?:\\s+(?:[\\d.]+(?:%|em)|0|auto|inherit|(?:var|env)\\([^()]*\\)|(?:calc|min|max|clamp)\\((?:[^()]|\\([^()]*\\))*var\\([^()]*\\)(?:[^()]|\\([^()]*\\))*\\)))?$/"
      ],
      "/^(margin|padding)-(inline|block)-(start|end)$/": [
        "/^(?:[\\d.]+(?:%|em)|0|auto|inherit|(?:var|env)\\([^()]*\\)|(?:calc|min|max|clamp)\\((?:[^()]|\\([^()]*\\))*var\\([^()]*\\)(?:[^()]|\\([^()]*\\))*\\))$/"
      ],
      "/^font-size$/": [
        "/^var\\(--(?:text-(?:display|2xl|xl|lg|md|base|sm|xs)|mono-(?:lg|md))\\)$/",
        "/^(?:calc|min|max|clamp)\\((?:[-+*/,.\\d\\s]|var\\(--(?:text-(?:display|2xl|xl|lg|md|base|sm|xs)|mono-(?:lg|md))\\))+\\)$/",
        "inherit"
      ]
    },
    "declaration-property-value-disallowed-list": {
      "/^grid-template(-columns)?$/": [
        "/minmax\\(\\s*(?!0\\s*[,)])[\\d.]/",
        "/minmax\\(\\s*min\\(\\s*[\\d.]/"
      ]
    }
  },
  "overrides": [
    {
      "files": ["src/components/settings/advanced/**/*.css"],
      "rules": {
        "declaration-property-value-allowed-list": {
          "/^border-radius$/": [
            "/^var\\(--radius-(pill|lg|md|sm|full)\\)$/",
            "/^var\\(--radius-(pill|lg|md|sm|full)\\) var\\(--radius-(pill|lg|md|sm|full)\\)( var\\(--radius-(pill|lg|md|sm|full)\\) var\\(--radius-(pill|lg|md|sm|full)\\))?$/",
            "/^calc\\(\\s*var\\(--radius-md\\)\\s*-\\s*7px\\s*\\)$/",
            "12px",
            "0",
            "inherit"
          ],
          "/^border-(top|bottom)-(left|right)-radius$/": [
            "/^var\\(--radius-(pill|lg|md|sm|full)\\)$/",
