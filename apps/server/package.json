{
  "name": "@loombre/server",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "loombre": "./bin/loombre.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@loombre/contract": "workspace:*",
    "@loombre/controller-ipc": "workspace:*",
    "@loombre/db": "workspace:*",
    "@loombre/jobs": "workspace:*",
    "@loombre/playback-engine": "workspace:*",
    "@loombre/plugin-host": "workspace:*",
    "@loombre/plugin-protocol": "workspace:*",
    "@loombre/provisioning": "workspace:*",
    "@loombre/provisioning-pg": "workspace:*",
    "@loombre/release-manifest": "workspace:*",
    "@loombre/secrets": "workspace:*",
    "@loombre/shared": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "acme-client": "5.4.0",
    "ajv": "^8.20.0",
    "hash-wasm": "^4.12.0",
    "jose": "^6.2.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@loombre/sdk": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "24.13.3",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "4.23.1"
  }
}
