    "chokidar": "^5.0.0",
    "fast-xml-parser": "^5.10.1",
    "music-metadata": "^11.14.0",
    "sharp": "^0.35.3",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
