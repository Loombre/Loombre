  },
  "devDependencies": {
    "@redocly/cli": "^2.40.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.13.0",
    "redoc": "2.5.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
