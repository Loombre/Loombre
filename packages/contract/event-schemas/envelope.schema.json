{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loombre.com/schemas/events/envelope.schema.json",
  "title": "EventEnvelope",
  "description": "Envelope for every message delivered over the websocket /v1/events channel and every row written to the events outbox table (docs/PLAN.md §4.3, §6.3). The payload schema is selected by `type`. Additive-only evolution: see README.md in this directory.",
  "x-loombre-admin-only-event-types": [
    "job.updated",
    "settings.updated",
    "plugin.registered",
    "plugin.updated",
    "plugin.enabled",
    "plugin.disabled",
    "plugin.removed",
    "plugin.health-changed",
    "metadata.match-candidates",
    "user.restricted-pin-reset",
    "probe.failed",
    "stash.provider.disabled",
    "stash.provider.connected",
    "stash.sync.started",
    "stash.sync.completed",
    "mail.failed",
    "user.invited",
    "user.invite-revoked",
    "user.claimed",
    "user.password-reset",
    "session.revoked-by-password-change",
    "remote.enabled",
    "remote.disabled",
    "remote.device.enrolled",
    "remote.device.revoked",
    "remote.path.changed",
    "tunnel.connector.state",
    "posture.regressed",
    "posture.recovered",
    "probe.arrived"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "tsMs", "actorUserId", "payload"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7, matches the events.id outbox row."
    },
    "type": {
      "type": "string",
      "enum": [
        "item.added",
        "item.updated",
        "file.relocated",
        "playback.started",
        "playback.ended",
        "playback.progress",
        "progress.updated",
        "user.created",
        "library.created",
        "scan.started",
        "scan.completed",
        "restricted.locked",
        "restricted.unlocked",
        "watchlist.added",
        "watchlist.removed",
        "job.updated",
        "settings.updated",
        "plugin.registered",
        "plugin.updated",
        "plugin.enabled",
        "plugin.disabled",
        "plugin.removed",
        "plugin.health-changed",
        "metadata.match-candidates",
        "user.restricted-pin-reset",
        "probe.failed",
        "stash.provider.disabled",
        "stash.provider.connected",
        "stash.sync.started",
        "stash.sync.completed",
        "mail.failed",
        "user.invited",
        "user.invite-revoked",
        "user.claimed",
        "user.password-reset",
        "session.revoked-by-password-change",
        "notice.published",
        "notice.cancelled",
        "remote.enabled",
        "remote.disabled",
        "remote.device.enrolled",
        "remote.device.revoked",
        "remote.path.changed",
        "tunnel.connector.state",
        "posture.regressed",
        "posture.recovered",
        "probe.arrived"
      ],
      "description": "Closed enum today; additions are additive contract PRs (new event types are always backward compatible for existing consumers)."
    },
    "tsMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Epoch milliseconds the event was written, server clock."
    },
    "actorUserId": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "User whose action produced the event; null for system-originated events (e.g. scan.completed on an unattended schedule)."
    },
    "payload": {
      "description": "Type-specific payload; validated against the matching <type>.schema.json in this directory.",
      "type": "object"
    }
  }
}
