{
  "scenario": "vaapi route, vulkan tone-map (§8.3's 'else vulkan' half) — pure-hw route (a): -hwaccel_output_format vaapi pins the decode surface",
  "args": [
    "-hide_banner",
    "-loglevel",
    "warning",
    "-nostdin",
    "-hwaccel",
    "vaapi",
    "-hwaccel_output_format",
    "vaapi",
    "-i",
    "{INPUT}",
    "-map",
    "0:a:0",
    "-filter_complex",
    "[0:v:0]libplacebo=tonemapping=hable:format=yuv420p[vout]",
    "-map",
    "[vout]",
    "-c:v",
    "h264_vaapi",
    "-b:v",
    "4000000",
    "-maxrate",
    "4000000",
    "-bufsize",
    "8000000",
    "-g",
    "48",
    "-force_key_frames",
    "expr:gte(t,n_forced*{SEG_DUR})",
    "-c:a",
    "copy",
    "-f",
    "hls",
    "-hls_time",
    "{SEG_DUR}",
    "-hls_playlist_type",
    "event",
    "-hls_segment_type",
    "fmp4",
    "-hls_fmp4_init_filename",
    "init.mp4",
    "-start_number",
    "{START_SEG}",
    "-hls_segment_filename",
    "{SESSION_DIR}/s%06d.m4s",
    "{SESSION_DIR}/media.m3u8"
  ]
}
