{
  "scenario": "embed strategy (mux-copy, e.g. webvtt) — -map 0:s:0 in the mapping segment, -c:s copy at the END of the audio block",
  "args": [
    "-hide_banner",
    "-loglevel",
    "warning",
    "-nostdin",
    "-i",
    "{INPUT}",
    "-map",
    "0:v:0",
    "-map",
    "0:a:0",
    "-map",
    "0:s:0",
    "-c:v",
    "copy",
    "-c:a",
    "copy",
    "-c:s",
    "copy",
    "-f",
    "hls",
    "-hls_time",
    "{SEG_DUR}",
    "-hls_playlist_type",
    "event",
    "-hls_segment_type",
    "fmp4",
    "-hls_fmp4_init_filename",
    "init.mp4",
    "-start_number",
    "{START_SEG}",
    "-hls_segment_filename",
    "{SESSION_DIR}/s%06d.m4s",
    "{SESSION_DIR}/media.m3u8"
  ]
}
