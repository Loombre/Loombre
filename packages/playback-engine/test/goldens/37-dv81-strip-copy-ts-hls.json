{
  "scenario": "sibling of scenario 35 over the mpegts HLS path — the DV strip is container-independent (it belongs to every repackage, not just fmp4); -tag:v hvc1 is harmless on mpegts, which has no sample entry at all",
  "args": [
    "-hide_banner",
    "-loglevel",
    "warning",
    "-nostdin",
    "-i",
    "{INPUT}",
    "-map",
    "0:v:0",
    "-map",
    "0:a:0",
    "-c:v",
    "copy",
    "-bsf:v",
    "filter_units=remove_types=62-63",
    "-tag:v",
    "hvc1",
    "-c:a",
    "copy",
    "-f",
    "hls",
    "-hls_time",
    "{SEG_DUR}",
    "-hls_playlist_type",
    "event",
    "-hls_segment_type",
    "mpegts",
    "-start_number",
    "{START_SEG}",
    "-hls_segment_filename",
    "{SESSION_DIR}/s%06d.ts",
    "{SESSION_DIR}/media.m3u8"
  ]
}
