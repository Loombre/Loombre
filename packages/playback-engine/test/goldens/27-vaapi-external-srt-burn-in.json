{
  "scenario": "vaapi external SRT sidecar burn-in (step 7b fix F4) — second -i {SUBTITLE_SIDECAR}, [0:v:0]hwdownload,format=nv12[vfilt];[vfilt][1:s:0]overlay,hwupload[vout]",
  "args": [
    "-hide_banner",
    "-loglevel",
    "warning",
    "-nostdin",
    "-hwaccel",
    "vaapi",
    "-i",
    "{INPUT}",
    "-i",
    "{SUBTITLE_SIDECAR}",
    "-map",
    "0:a:0",
    "-filter_complex",
    "[0:v:0]hwdownload,format=nv12[vfilt];[vfilt][1:s:0]overlay,hwupload[vout]",
    "-map",
    "[vout]",
    "-c:v",
    "h264_vaapi",
    "-b:v",
    "4000000",
    "-maxrate",
    "4000000",
    "-bufsize",
    "8000000",
    "-g",
    "48",
    "-force_key_frames",
    "expr:gte(t,n_forced*{SEG_DUR})",
    "-c:a",
    "copy",
    "-f",
    "hls",
    "-hls_time",
    "{SEG_DUR}",
    "-hls_playlist_type",
    "event",
    "-hls_segment_type",
    "fmp4",
    "-hls_fmp4_init_filename",
    "init.mp4",
    "-start_number",
    "{START_SEG}",
    "-hls_segment_filename",
    "{SESSION_DIR}/s%06d.m4s",
    "{SESSION_DIR}/media.m3u8"
  ]
}
