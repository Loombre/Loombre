{
  "scenario": "nvenc tone-map hybrid fallback, route (b) — the non-VT counterpart of scenario 28: yadif (a software-only filter) means NO -hwaccel_output_format and NO tonemap_cuda/scale_cuda, so plain -hwaccel cuda auto-downloads frames once and the whole §6 chain runs in software with the cpu-zscale string in the tonemap position, nvenc still encoding",
  "args": [
    "-hide_banner",
    "-loglevel",
    "warning",
    "-nostdin",
    "-hwaccel",
    "cuda",
    "-i",
    "{INPUT}",
    "-map",
    "0:a:0",
    "-filter_complex",
    "[0:v:0]yadif,scale=-2:1080,zscale=t=linear:npl=100,tonemap=hable:desat=0,zscale=p=bt709:t=bt709:m=bt709:r=tv,format=yuv420p[vout]",
    "-map",
    "[vout]",
    "-c:v",
    "h264_nvenc",
    "-preset",
    "p4",
    "-b:v",
    "4000000",
    "-maxrate",
    "4000000",
    "-bufsize",
    "8000000",
    "-g",
    "48",
    "-force_key_frames",
    "expr:gte(t,n_forced*{SEG_DUR})",
    "-c:a",
    "copy",
    "-f",
    "hls",
    "-hls_time",
    "{SEG_DUR}",
    "-hls_playlist_type",
    "event",
    "-hls_segment_type",
    "fmp4",
    "-hls_fmp4_init_filename",
    "init.mp4",
    "-start_number",
    "{START_SEG}",
    "-hls_segment_filename",
    "{SESSION_DIR}/s%06d.m4s",
    "{SESSION_DIR}/media.m3u8"
  ]
}
