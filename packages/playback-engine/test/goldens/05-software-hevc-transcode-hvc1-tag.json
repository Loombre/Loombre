{
  "scenario": "software libx265 transcode at 2160p (rung matches source height, no scale) — hevc target always adds -tag:v hvc1",
  "args": [
    "-hide_banner",
    "-loglevel",
    "warning",
    "-nostdin",
    "-i",
    "{INPUT}",
    "-map",
    "0:v:0",
    "-map",
    "0:a:0",
    "-c:v",
    "libx265",
    "-preset",
    "veryfast",
    "-b:v",
    "16000000",
    "-maxrate",
    "16000000",
    "-bufsize",
    "32000000",
    "-g",
    "48",
    "-force_key_frames",
    "expr:gte(t,n_forced*{SEG_DUR})",
    "-tag:v",
    "hvc1",
    "-c:a",
    "copy",
    "-f",
    "hls",
    "-hls_time",
    "{SEG_DUR}",
    "-hls_playlist_type",
    "event",
    "-hls_segment_type",
    "fmp4",
    "-hls_fmp4_init_filename",
    "init.mp4",
    "-start_number",
    "{START_SEG}",
    "-hls_segment_filename",
    "{SESSION_DIR}/s%06d.m4s",
    "{SESSION_DIR}/media.m3u8"
  ]
}
