{
  "scenario": "nvenc route (a) WITH a rung downscale — the pinned cuda surface forbids the software `scale` filter, so scale_cuda takes §6's scale position ahead of tonemap_cuda (nvenc's analogue of videotoolbox's scale_vt fold)",
  "args": [
    "-hide_banner",
    "-loglevel",
    "warning",
    "-nostdin",
    "-hwaccel",
    "cuda",
    "-hwaccel_output_format",
    "cuda",
    "-i",
    "{INPUT}",
    "-map",
    "0:a:0",
    "-filter_complex",
    "[0:v:0]scale_cuda=w=-2:h=1080,tonemap_cuda=format=yuv420p:tonemap=hable[vout]",
    "-map",
    "[vout]",
    "-c:v",
    "h264_nvenc",
    "-preset",
    "p4",
    "-b:v",
    "4000000",
    "-maxrate",
    "4000000",
    "-bufsize",
    "8000000",
    "-g",
    "48",
    "-force_key_frames",
    "expr:gte(t,n_forced*{SEG_DUR})",
    "-c:a",
    "copy",
    "-f",
    "hls",
    "-hls_time",
    "{SEG_DUR}",
    "-hls_playlist_type",
    "event",
    "-hls_segment_type",
    "fmp4",
    "-hls_fmp4_init_filename",
    "init.mp4",
    "-start_number",
    "{START_SEG}",
    "-hls_segment_filename",
    "{SESSION_DIR}/s%06d.m4s",
    "{SESSION_DIR}/media.m3u8"
  ]
}
