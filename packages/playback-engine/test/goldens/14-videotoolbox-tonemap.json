{
  "scenario": "videotoolbox route, videotoolbox tone-map — pure-hw route (a): -hwaccel_output_format videotoolbox_vld keeps decode on the VT surface, scale_vt tone-maps in hw (bare form — rung matches source height, no downscale to fold)",
  "args": [
    "-hide_banner",
    "-loglevel",
    "warning",
    "-nostdin",
    "-hwaccel",
    "videotoolbox",
    "-hwaccel_output_format",
    "videotoolbox_vld",
    "-i",
    "{INPUT}",
    "-map",
    "0:a:0",
    "-filter_complex",
    "[0:v:0]scale_vt=color_matrix=bt709:color_primaries=bt709:color_transfer=bt709[vout]",
    "-map",
    "[vout]",
    "-c:v",
    "h264_videotoolbox",
    "-b:v",
    "4000000",
    "-maxrate",
    "4000000",
    "-bufsize",
    "8000000",
    "-g",
    "48",
    "-force_key_frames",
    "expr:gte(t,n_forced*{SEG_DUR})",
    "-c:a",
    "copy",
    "-f",
    "hls",
    "-hls_time",
    "{SEG_DUR}",
    "-hls_playlist_type",
    "event",
    "-hls_segment_type",
    "fmp4",
    "-hls_fmp4_init_filename",
    "init.mp4",
    "-start_number",
    "{START_SEG}",
    "-hls_segment_filename",
    "{SESSION_DIR}/s%06d.m4s",
    "{SESSION_DIR}/media.m3u8"
  ]
}
