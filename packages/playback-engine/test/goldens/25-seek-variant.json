{
  "scenario": "session-layer seek-restart regeneration (withSeek: true) — -ss {SEEK_SECONDS} before -i; -start_number {START_SEG} still present (BIND: always present regardless of withSeek)",
  "args": [
    "-hide_banner",
    "-loglevel",
    "warning",
    "-nostdin",
    "-noaccurate_seek",
    "-ss",
    "{SEEK_SECONDS}",
    "-i",
    "{INPUT}",
    "-map",
    "0:v:0",
    "-map",
    "0:a:0",
    "-c:v",
    "libx264",
    "-preset",
    "veryfast",
    "-b:v",
    "4000000",
    "-maxrate",
    "4000000",
    "-bufsize",
    "8000000",
    "-g",
    "48",
    "-force_key_frames",
    "expr:gte(t,n_forced*{SEG_DUR})",
    "-c:a",
    "copy",
    "-f",
    "hls",
    "-hls_time",
    "{SEG_DUR}",
    "-hls_playlist_type",
    "event",
    "-hls_segment_type",
    "fmp4",
    "-hls_fmp4_init_filename",
    "init.mp4",
    "-start_number",
    "{START_SEG}",
    "-hls_segment_filename",
    "{SESSION_DIR}/s%06d.m4s",
    "{SESSION_DIR}/media.m3u8"
  ]
}
