  // expectTypeOf/@ts-expect-error assertions in test/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false
  },
  "include": ["src", "test"]
}
