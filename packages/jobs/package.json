{
  "name": "@loombre/jobs",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Typed job-queue abstraction (D5) with a pg-boss driver on Tier-0 (no Redis daemon required for small installs). Ledger-mirrors every enqueue/lifecycle transition into the `jobs` table via @loombre/db/internal.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@loombre/db": "workspace:*",
    "pg-boss": "^12.26.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
